<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The game's surfaces and sounds are native memory (OpenNspw/ddraw.cs, dsound.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The original's icon (Original/NSPW_NET/NSPW_NET.RC). -->
    <ApplicationIcon>..\..\Original\NSPW_NET\nspw_icon.ICO</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window's icon: MonoGame loads it from the resource Icon.bmp, nspw_icon.ICO converted to a 32-bit bitmap. -->
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
    <!-- The app's font and its license (BundledFonts), beside the app. -->
    <None Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The sprites cut from the original's sprite sheet (SpriteFiles, tools/CutSprites.cs). -->
    <EmbeddedResource Include="Sprites\**\*.png" />
    <!-- The original's files that the game reads (BundledOriginal), so that players need none of their own: NSPW NET's
         data, and NSPW 1.22 with the files of its directory that a single-player game reads. -->
    <EmbeddedResource Include="..\..\Original\NSPW_NET\t3.bmp" LogicalName="Original/NSPW_NET/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Original\NSPW_NET\wav\*.wav" LogicalName="Original/NSPW_NET/wav/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Original\NSPW_NET\Map\*.dat" LogicalName="Original/NSPW_NET/Map/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Original\NSPW_NET\Scenario\*.dat" LogicalName="Original/NSPW_NET/Scenario/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Original\Nspw122\NSPW_122.exe;..\..\Original\Nspw122\tst_cg1.bmp" LogicalName="Original/Nspw122/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Original\Nspw122\wav\*.wav" LogicalName="Original/Nspw122/wav/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Original\Nspw122\Map\*.dat" LogicalName="Original/Nspw122/Map/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" />
    <PackageReference Include="MonoGame.Extended" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenNspw\OpenNspw.csproj" />
    <ProjectReference Include="..\OpenNspw.DirectPlay\OpenNspw.DirectPlay.csproj" />
    <ProjectReference Include="..\..\Saruhashi\Aigamo.Saruhashi.MonoGame\Aigamo.Saruhashi.MonoGame.csproj" />
  </ItemGroup>

</Project>
