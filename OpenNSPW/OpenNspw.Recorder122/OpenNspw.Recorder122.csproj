<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- It debugs NSPW_122.exe, a 32-bit program, with the 32-bit debugger API and CONTEXT. -->
