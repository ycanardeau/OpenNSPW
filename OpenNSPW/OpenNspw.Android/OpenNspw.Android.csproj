<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not part of OpenNSPW.slnx: it needs the android workload (`dotnet workload install android`), which the CI's build of
       the solution does not have. -->
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ApplicationId>io.github.ycanardeau.opennspw</ApplicationId>
    <ApplicationTitle>OpenNSPW</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- Mono's JIT in Debug too, not its interpreter, which Debug builds use by default for hot reload: the interpreter keeps
         a struct's size and its fields' offsets in 16 bits, and the game's state holds structs of more than 64 KiB, such as
         its map (Nspw.MapTiles), whose fields after them it would lay out over them. -->
    <UseInterpreter>false</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <!-- The app's MonoGame (OpenNspw.App.csproj): Android's, on OpenGL ES. -->
    <PackageReference Include="MonoGame.Framework.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenNspw.App\OpenNspw.App.csproj" />
  </ItemGroup>

</Project>
