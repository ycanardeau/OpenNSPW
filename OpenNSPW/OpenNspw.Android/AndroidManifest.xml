<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Network games: DirectPlay over UDP (OpenNspw.DirectPlay). -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-feature android:glEsVersion="0x00020000" android:required="true" />
  <!-- Back goes to the activity's callback from Android 13 on (MainActivity.PressEscape), not as a key. -->
  <application android:label="OpenNSPW" android:allowBackup="true" android:enableOnBackInvokedCallback="true" />
</manifest>
