root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.cs]
csharp_style_namespace_declarations=file_scoped:suggestion

# Collection expressions
dotnet_diagnostic.IDE0028.severity = error
dotnet_diagnostic.IDE0300.severity = error
dotnet_diagnostic.IDE0301.severity = error
dotnet_diagnostic.IDE0302.severity = error
dotnet_diagnostic.IDE0303.severity = error
dotnet_diagnostic.IDE0304.severity = error
dotnet_diagnostic.IDE0305.severity = error
dotnet_diagnostic.IDE0306.severity = error

# Warnings
dotnet_diagnostic.CS0067.severity = error
dotnet_diagnostic.CS0108.severity = error
dotnet_diagnostic.CS1570.severity = error
dotnet_diagnostic.CS4014.severity = error
dotnet_diagnostic.xUnit1026.severity = error

# Tasks
dotnet_diagnostic.VSTHRD002.severity = error
dotnet_diagnostic.VSTHRD103.severity = none
dotnet_diagnostic.VSTHRD110.severity = error
dotnet_diagnostic.VSTHRD200.severity = error

# Suggestions
# Not AMG003: the `closed` it asks for is C# 15's, which the pinned SDK's compiler does not have, though LangVersion preview
# makes the analyzer think it does.
dotnet_diagnostic.CA1069.severity = error
dotnet_diagnostic.CA1510.severity = error
dotnet_diagnostic.CA1513.severity = error
dotnet_diagnostic.CA1816.severity = error
dotnet_diagnostic.CA1822.severity = error
dotnet_diagnostic.CA1825.severity = error
dotnet_diagnostic.CA1859.severity = error
dotnet_diagnostic.CA1860.severity = error
dotnet_diagnostic.CA1861.severity = error
dotnet_diagnostic.CS1591.severity = error
dotnet_diagnostic.IDE0017.severity = error
dotnet_diagnostic.IDE0031.severity = error
dotnet_diagnostic.IDE0038.severity = error
dotnet_diagnostic.IDE0039.severity = error
dotnet_diagnostic.IDE0042.severity = error
dotnet_diagnostic.IDE0054.severity = error
dotnet_diagnostic.IDE0057.severity = error
dotnet_diagnostic.IDE0059.severity = error
dotnet_diagnostic.IDE0060.severity = error
dotnet_diagnostic.IDE0062.severity = error
dotnet_diagnostic.IDE0066.severity = error
dotnet_diagnostic.IDE0074.severity = error
dotnet_diagnostic.IDE0083.severity = error
dotnet_diagnostic.IDE0090.severity = error
dotnet_diagnostic.IDE0130.severity = error
dotnet_diagnostic.IDE0230.severity = error
dotnet_diagnostic.IDE0250.severity = error
dotnet_diagnostic.IDE0251.severity = error
dotnet_diagnostic.IDE0260.severity = error
dotnet_diagnostic.IDE0270.severity = error
dotnet_diagnostic.IDE1006.severity = error
dotnet_diagnostic.SYSLIB1045.severity = error
dotnet_diagnostic.SYSLIB1054.severity = error
dotnet_diagnostic.xUnit1004.severity = error
dotnet_diagnostic.xUnit1042.severity = error

# The ported files keep the originals' names, unused values and statements (docs/Porting.md): the files ported from NSPW
# NET, named after its files in lower case, and 1.22's scenarios, lifted from its machine code.
[{OpenNSPW/OpenNspw/[a-z]*.cs,OpenNSPW/OpenNspw/Scenarios122.cs}]
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.IDE0054.severity = none
dotnet_diagnostic.IDE0059.severity = none
dotnet_diagnostic.IDE0066.severity = none
dotnet_diagnostic.IDE1006.severity = none

# The tests named after the ported functions they test, and the disassembler's opcodes, named as Intel names them.
[{OpenNSPW/OpenNspw.Tests/Etc1Tests.cs,OpenNSPW/OpenNspw.Tests/Etc2Tests.cs,OpenNSPW/OpenNspw.Tests/Etc3Tests.cs,OpenNSPW/OpenNspw.Tests/MathTests.cs,Disassembler/**.cs}]
dotnet_diagnostic.IDE1006.severity = none

# Polyfills of runtime types for netstandard2.0, which the compiler and the code look for in the runtime's namespaces.
[{Enzan/Aigamo.Enzan/IsExternalInit.cs,Otsuki/Aigamo.Otsuki.Messages/CompilerFeatureRequiredAttribute.cs,Otsuki/Aigamo.Otsuki.Messages/IsClosedTypeAttribute.cs,Otsuki/Aigamo.Otsuki.Messages/IsExternalInit.cs,Otsuki/Aigamo.Otsuki.Messages/UnreachableException.cs}]
dotnet_diagnostic.IDE0130.severity = none
