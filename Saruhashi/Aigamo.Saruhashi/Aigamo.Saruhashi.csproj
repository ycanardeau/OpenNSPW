<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0, which .NET, .NET Framework 4.6.2 and later, and Mono load. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Authors>ycanardeau</Authors>
    <Description>Saruhashi is a UI framework for MonoGame.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ycanardeau/Saruhashi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ycanardeau/Saruhashi</RepositoryUrl>
  </PropertyGroup>

  <!-- What netstandard2.0 lacks of .NET's own API: HashCode. The rest is in Polyfills. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.HashCode" />
  </ItemGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
