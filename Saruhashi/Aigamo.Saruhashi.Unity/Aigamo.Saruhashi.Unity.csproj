<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0, as Aigamo.Saruhashi, for Unity to load. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Authors>ycanardeau</Authors>
    <Description>Saruhashi's backend for Unity, drawn with Unity's IMGUI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ycanardeau/Saruhashi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ycanardeau/Saruhashi</RepositoryUrl>
  </PropertyGroup>

  <!-- Unity's assemblies only to compile against: Saruhashi runs with the ones of the Unity that loads it. -->
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aigamo.Saruhashi\Aigamo.Saruhashi.csproj" />
  </ItemGroup>

  <!-- The demo's Unity project loads Saruhashi from its Assets/Plugins: each build copies the assemblies there, with their
  PDBs to debug them, and with the packages' own, which a library's output otherwise lacks. -->
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UnityDemoPluginsDir>$(MSBuildThisFileDirectory)..\Aigamo.Saruhashi.Unity.Demo\Assets\Plugins\</UnityDemoPluginsDir>
  </PropertyGroup>

  <Target Name="CopyToUnityDemo" AfterTargets="Build">
    <ItemGroup>
      <_UnityDemoPlugin Include="$(OutDir)*.dll;$(OutDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_UnityDemoPlugin)" DestinationFolder="$(UnityDemoPluginsDir)" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
