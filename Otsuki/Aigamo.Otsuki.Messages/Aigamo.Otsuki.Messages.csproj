<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Authors>ycanardeau</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ycanardeau/Otsuki</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ycanardeau/Otsuki</RepositoryUrl>
    <NoWarn>1701;1702;1591</NoWarn>
    <DocumentationFile>Aigamo.Otsuki.Messages.xml</DocumentationFile>
    <Description>DirectPlay 8 Reliable Protocol messages and DirectPlay 8 Core and Service Providers Protocol messages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aigamo.MatchGenerator">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Aigamo.Extensions.Primitives\Aigamo.Extensions.Primitives\Aigamo.Extensions.Primitives.csproj" />
    <ProjectReference Include="..\Aigamo.Otsuki.Analyzers\Aigamo.Otsuki.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
